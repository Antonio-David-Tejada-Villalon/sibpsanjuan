# Copiá este archivo a .env y completá los valores reales.
# En Render, estas mismas variables se cargan como "Environment Variables"
# del servicio, no hace falta un archivo .env ahí.

# Cadena de conexión de MongoDB Atlas (o de un Mongo local para desarrollo)
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/sibpsanjuan

# Cualquier string largo y al azar. Generalo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambiar-esto-por-un-valor-al-azar

# Puerto donde escucha Express (Render lo define solo, no hace falta tocarlo ahí)
PORT=3000

# Dejalo en 1 en producción (cookie solo por HTTPS). En desarrollo local sin
# HTTPS, poné 0 para poder loguearte.
COOKIE_SECURE=1

# Los dos siguientes solo hacen falta si el frontend se despliega en un
# origen distinto al de este backend (ej. frontend en Vercel + esta API en
# Render) — ver "Vercel + Render" en DEPLOY.md. Sin definirlos, el
# comportamiento de hoy (un solo servicio Express sirviendo todo) no cambia.

# URL exacta (con https://, sin barra final) del frontend desplegado aparte.
# Habilita CORS con credenciales solo para ese origen.
FRONTEND_URL=

# "none" para que la cookie de sesión viaje en pedidos cross-origin (requiere
# COOKIE_SECURE=1). Dejalo vacío/sin definir si front y back comparten origen.
COOKIE_SAMESITE=
