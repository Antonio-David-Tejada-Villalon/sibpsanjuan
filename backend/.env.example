# Copiá este archivo a .env y completá los valores reales.
# En Render, estas mismas variables se cargan como "Environment Variables"
# del servicio (render.yaml ya define cuáles), no hace falta un archivo .env ahí.

# Cadena de conexión de MongoDB Atlas (o de un Mongo local para desarrollo)
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/sibpsanjuan

# Cualquier string largo y al azar (en Render lo genera el Blueprint). A mano:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambiar-esto-por-un-valor-al-azar

# Puerto donde escucha Express (Render lo define solo, no hace falta tocarlo ahí)
PORT=3000

# Dejalo en 1 en producción (cookie solo por HTTPS). En desarrollo local sin
# HTTPS, poné 0 para poder loguearte.
COOKIE_SECURE=1

# --- Con Vercel adelante (el despliegue de DEPLOY.md) ---

# Dirección pública del sitio, la de Vercel o un dominio propio (con
# https://, sin barra final): canonical, sitemap, vistas previas al compartir
# y a dónde se manda a quien entre directo a la dirección de Render.
SITIO_URL=

# El mismo valor al azar en Render y en Vercel: Vercel lo manda en cada pedido
# que reenvía, y solo así se cree el IP del visitante que informa (ver
# src/middleware/proxy.js). Sin esto, el límite de intentos de ingreso es uno
# solo para todos los que entran por Vercel.
PROXY_SECRETO=

# --- Solo para un frontend en otro origen que le pegue directo a esta API ---
# (VITE_API_URL). No es lo recomendado: Safari y los iPhone bloquean la
# cookie de sesión entre sitios distintos y no se puede ingresar.

# URL exacta del frontend. Habilita CORS con credenciales solo para ese origen.
FRONTEND_URL=

# "none" para que la cookie viaje entre sitios (requiere COOKIE_SECURE=1).
COOKIE_SAMESITE=

# --- Portadas (ver src/portadas/) ---

# Opcional: clave de la API de Google Books. Sin ella se usa la cuota anónima
# compartida, que se agota seguido, y Google Books queda de hecho fuera del
# orden de búsqueda (Open Library sigue funcionando). Se crea en Google Cloud
# Console, restringida a la "Books API".
GOOGLE_BOOKS_API_KEY=

# 0 desactiva la búsqueda de portada en segundo plano al cargar un libro con
# ISBN (el botón "Buscar por ISBN" del panel sigue andando). Por defecto, activa.
PORTADAS_AUTOMATICAS=
